# Обязательные параметры
BOT_TOKEN=
SUPERADMIN_ID=

# База и расписание
DATABASE_URL=sqlite:///data/bot.db
TIMEZONE=Asia/Novosibirsk
SCHEDULE_SOURCE_URL=https://sgugit.ru/raspisanie
# Полная загрузка расписаний всех групп; минимум 180 минут (3 часа).
SYNC_INTERVAL_MIN=360

# Резервные копии и журналы
BACKUP_DIR=data/backups
LOG_LEVEL=INFO
DIRECTORY_URL=https://sgugit.ru/teachers/

# Необязательно: webhook (по умолчанию используется long polling)
# WEBHOOK_URL=
# WEBHOOK_PATH=telegram/webhook
# WEBHOOK_SECRET=
# WEBHOOK_PORT=8080
